# Copy to .env and fill in. Never commit .env.
# Guide: docs/setup-meta-app.md

# --- Credentials: choose ONE mode ---
# Multi-page: a long-lived user (or System User) token; all your Pages are discovered.
FB_USER_ACCESS_TOKEN=
# Single page: uncomment both (and leave FB_USER_ACCESS_TOKEN empty/removed).
# FB_PAGE_ID=
# FB_PAGE_ACCESS_TOKEN=

# Optional: Page id or name used when a tool call does not specify one.
# FB_DEFAULT_PAGE=

# Recommended: enables appsecret_proof signing.
FB_APP_SECRET=

# FB_GRAPH_API_VERSION=v26.0
# FB_TIMEOUT=30
# FB_UPLOAD_TIMEOUT=900

# --- MCP server ---
# MCP_TRANSPORT=stdio
# MCP_HOST=127.0.0.1
# MCP_PORT=8000
# MCP_PATH=/mcp
# MCP_AUTH_TOKEN=
# MCP_READ_ONLY=false
# MCP_LOG_LEVEL=INFO
